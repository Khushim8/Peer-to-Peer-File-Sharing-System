  {"id": "python.lang.security.audit.path-traversal.open-user-path", "defaultConfiguration": {"level": "warning"},
   "properties": {"tags": ["CWE-22: Path Traversal", "security"]}}]}},
  "results": [
  {"ruleId": "dockerfile.security.missing-user.missing-user", "message": {"text": "No USER"},
   "fingerprints": {"matchBasedId/v1": "requires login"},
