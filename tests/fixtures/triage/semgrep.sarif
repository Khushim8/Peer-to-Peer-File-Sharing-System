  {"ruleId": "dockerfile.security.missing-user.missing-user", "message": {"text": "No USER"},
   "locations": [{"physicalLocation": {"artifactLocation": {"uri": "p2p\\peer_client\\Dockerfile"}, "region": {"startLine": 16}}}]},
  {"ruleId": "python.lang.security.audit.path-traversal.open-user-path", "message": {"text": "User path in open()"},
